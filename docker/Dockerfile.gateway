FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    GRPC_SERVER_ADDR="grpc_server:50051" \
    PORT=8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY proto/ /app/proto/
COPY backend/grpc_server/compile_proto.py /app/backend/grpc_server/compile_proto.py
COPY backend/gateway/ /app/backend/gateway/
COPY frontend/ /app/frontend/

RUN python /app/backend/grpc_server/compile_proto.py

WORKDIR /app/backend/gateway
EXPOSE 8000

CMD ["uvicorn", "gateway:app", "--host", "0.0.0.0", "--port", "8000"]
